# Copy to .env and fill in from Supabase → Project Settings → API
#
# Use the VITE_ prefix. The dashboard shows NEXT_PUBLIC_ names because its
# snippet assumes Next.js; Vite only exposes variables starting with VITE_.
# (The code accepts either, but VITE_ is the correct one here.)
#
# The publishable / anon key is meant to be public — it identifies the project
# and grants nothing on its own. The Row Level Security policies in
# supabase-schema.sql are what actually restrict access, and they only allow
# the emails listed in the allowed_emails table.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
